{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1,14330;Database=CryptoTrackerDb;User Id=SA;Password=YourStrong@Passw0rd;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "CryptoTrackerAPI",
    "Audience": "CryptoTrackerClient",
    "Key": "CHANGE_THIS_TO_A_LONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshReuseGraceSeconds": 10
  },
  "RefreshTokenCleanup": {
    "IntervalHours": 24,
    "RevokedRetentionDays": 30
  },
  "AlertMonitoring": {
    "IntervalSeconds": 60
  },
  "PortfolioSnapshot": {
    "CheckIntervalMinutes": 5,
    "HourlyRetentionDays": 30,
    "MaxRetentionDays": 365
  },
  "TradingBot": {
    "SignalExpirationMinutes": 15,
    "RiskExitMaxAttempts": 5,
    "RiskExitRetryDelayMinutes": 2
  },
  "Notifications": {
    "CooldownMinutes": 60
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "RateLimiting": {
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60,
    "GeneralPermitLimit": 300,
    "GeneralWindowSeconds": 60
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "FromAddress": "no-reply@cryptotracker.local",
    "FromName": "CryptoTracker"
  }
}
