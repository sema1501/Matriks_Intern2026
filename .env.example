# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Buradaki değerler yalnızca yerel geliştirme içindir, üretimde mutlaka değiştirin.

# SQL Server SA şifresi. En az 8 karakter; büyük harf, küçük harf, rakam ve sembol içermeli.
# dotnet run ile çalışıyorsanız appsettings.json içindeki bağlantı dizesi de bu şifreyi kullanır.
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# Access token imzalama anahtarı, en az 32 karakter.
JWT_KEY=yerel-gelistirme-anahtari-en-az-32-karakter

# İsteğe bağlı. SMTP_HOST boşsa e-postalar gönderilmez, API loguna yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# İsteğe bağlı. Boşsa bot Binance Testnet'e emir gönderemez, uygulamanın geri kalanı çalışır.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
